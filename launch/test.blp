using Gtk 4.0;

// 定义主窗口
ApplicationWindow main_window {
  title: "Tideflow Launcher";
  default-width: 600;
  default-height: 400;
  decorated: false; // 无边框

  // 主垂直容器
  Box {
    orientation: vertical;
    spacing: 10;
    margin-top: 15;
    margin-bottom: 15;
    margin-start: 15;
    margin-end: 15;

    // 搜索框
    SearchEntry search_entry {
      placeholder-text: "Search applications...";
      // 这里的 => 意思是当发生 search-changed 信号时，调用 C++ 代码里的 on_search_changed 函数
      search-changed => $on_search_changed();
    }

    // 应用图标网格区域
    ScrolledWindow {
      hexpand: true;
      vexpand: true;
      
      FlowBox app_flowbox {
        homogeneous: true;
        max-children-per-line: 4;
        row-spacing: 15;
        column-spacing: 15;
        
        // 我们在这里先塞两个假数据看看效果
        // 实际开发中，这些会由 C++ 代码动态生成
        Button {
          label: "Firefox";
          width-request: 80;
          height-request: 80;
        }
        Button {
          label: "Terminal";
          width-request: 80;
          height-request: 80;
        }
      }
    }
  }
}
